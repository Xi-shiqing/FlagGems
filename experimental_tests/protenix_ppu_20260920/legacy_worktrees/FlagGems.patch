+def _pad_setup_context(ctx, inputs, output):
+    self, pad, mode, value = inputs
+    ctx.pad = tuple(pad)
+    ctx.mode = mode
+    if mode in ("reflect", "replicate"):
+        ctx.save_for_backward(self)
+
+
+def _pad_backward(ctx, grad_output):
+    if ctx.mode == "constant":
+        inverse_pad = tuple(-value for value in ctx.pad)
+        grad_input = torch.ops.aten.constant_pad_nd.default(
+            grad_output, inverse_pad, 0
+        )
+    elif ctx.mode in ("reflect", "replicate"):
+        (self,) = ctx.saved_tensors
+        dims = len(ctx.pad) // 2
+        prefix = "reflection" if ctx.mode == "reflect" else "replication"
+        backward = getattr(torch.ops.aten, f"{prefix}_pad{dims}d_backward").default
+        grad_input = backward(grad_output, self, ctx.pad)
+    else:
+        raise NotImplementedError(
+            f"FlagGems pad backward does not support mode={ctx.mode!r}"
+        )
+    return grad_input, None, None, None
+
+
+# The CUDA dispatcher override needs an explicit Autograd formula. Without it,
+# the Triton pad forward succeeds but the input gradient is silently dropped.
+torch.library.register_autograd(
+    "aten::pad", _pad_backward, setup_context=_pad_setup_context
+)
