+    pid = tle.program_id(0).to(index_dtype)
+    grid_n = tl.cdiv(N, BLOCK_N)
+    rm = (pid // grid_n * BLOCK_M + tl.arange(0, BLOCK_M)).to(index_dtype)
+    rn = (pid % grid_n * BLOCK_N + tl.arange(0, BLOCK_N)).to(index_dtype)
+    chunk_k = tl.cdiv(K, SPLIT_K)
+    result = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    for split_id in range(0, SPLIT_K):
+        split_start = split_id * chunk_k
+        split_end = tl.minimum(split_start + chunk_k, K)
+        acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+        _balanced_other = tl.full(acc.shape, 0, tl.float32)
+        _balanced_index = 0
