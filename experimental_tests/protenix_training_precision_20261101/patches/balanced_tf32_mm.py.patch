+@libentry()
+@libtuner(configs=[triton.Config({'BLOCK_M': 32, 'BLOCK_N': 32, 'BLOCK_K': 32}, num_warps=4, num_stages=1)], key=['M', 'N', 'K', 'stride_am', 'stride_bk'], strategy=['align32', 'align32', 'align32', 'align32', 'align32'], warmup=5, rep=10)
