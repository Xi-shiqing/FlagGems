+            rk = (split_start + offset_k + tl.arange(0, BLOCK_K)).to(index_dtype)
+            mask_k = rk < split_end
+            a = tl.load(A + rm[:, None] * stride_am + rk[None, :] * stride_ak, mask=(rm < M)[:, None] & mask_k[None, :], other=0.0)
+            b = tl.load(B + rk[:, None] * stride_bk + rn[None, :] * stride_bn, mask=mask_k[:, None] & (rn < N)[None, :], other=0.0)
