+@triton.jit
+def _bmm_tf32_preconverted_balanced_tf32(A, B, O, M: tl.constexpr, N: tl.constexpr, K: tl.constexpr, BATCH: tl.constexpr, AS0: tl.constexpr, AS1: tl.constexpr, AS2: tl.constexpr, BS0: tl.constexpr, BS1: tl.constexpr, BS2: tl.constexpr, OS0: tl.constexpr, OS1: tl.constexpr, OS2: tl.constexpr, TILE_M: tl.constexpr, TILE_N: tl.constexpr, TILE_K: tl.constexpr):
